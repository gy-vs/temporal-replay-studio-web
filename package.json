{
  "name": "temporal-replay-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --banner:js=\"globalThis.__TRS_MAIN__ = require.main === module; globalThis.__TRS_DIR__ = __dirname;\" --outfile=dist-server/server.cjs && node -e \"require('fs').cpSync('src/server/workflows','dist-server/workflows',{recursive:true})\" && vite build",
    "start": "node dist-server/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
